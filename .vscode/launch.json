    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch zoraxy",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src/",
            "args": ["-mdns=false","-docker","-noauth", "-port=:8443","-default_inbound_port=10443","-default_inbound_enabled=true"]
        },
        {
            "name": "Launch zoraxy show-ver",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src/",
            "args": ["-version"]
        }


    ]
}